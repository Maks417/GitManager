# Signing / release (CI secrets — do not commit real values)
# GH_TOKEN=
# CSC_LINK=
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Optional bundled Git path
# GIT_MANAGER_GIT_PATH=

# OAuth broker (binds to 127.0.0.1 unless HOST is set)
# HOST=127.0.0.1
# PORT=8787
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=
