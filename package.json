{
  "name": "git-manager",
  "version": "1.1.0",
  "description": "Cross-platform Git repository manager with history-first UI",
  "main": "./out/main/index.js",
  "author": "GitManager",
  "license": "MIT",
  "homepage": "https://github.com/Maks417/GitManager",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maks417/GitManager.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release": "npm run build && electron-builder --publish always",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.45.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.1",
    "vitest": "^5.0.0"
  }
}
